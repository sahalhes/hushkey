{
  "name": "hushkey",
  "version": "0.1.0",
  "description": "Local secret sanitization for explicit AI assistant workflows",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "hushkey": "dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./vault": { "types": "./dist/vault.d.ts", "import": "./dist/vault.js" },
    "./codex": { "types": "./dist/codex.d.ts", "import": "./dist/codex.js" },
    "./chatgpt": { "types": "./dist/chatgpt.d.ts", "import": "./dist/chatgpt.js" }
  },
  "files": ["dist", "README.md", "LICENSE", "docs", "examples"],
  "devDependencies": {
    "@types/node": "14.18.63",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build"
  }
}
